{
  "name": "bark-api",
  "version": "1.0.0",
  "description": "Dog bark detection REST API",
  "main": "src/backend/server.js",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest src/tests/unit --forceExit",
    "test:integration": "jest src/tests/integration --forceExit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.0",
    "mongodb-memory-server": "^9.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
